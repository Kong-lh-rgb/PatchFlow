# =============================================================================
# PatchFlow 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，严禁提交真实密钥。
# =============================================================================

# 运行环境：development | test | production
NODE_ENV=development

# 日志级别：trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Fastify API 监听端口
API_PORT=3001

# Web 前端请求 API 的基础地址（服务端与浏览器均使用）
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# PostgreSQL 连接串（与 docker-compose.yml 默认值保持一致）
# 注意：Compose 默认把宿主端口映射到 5433，避免与本机已运行的 PostgreSQL(5432) 冲突。
DATABASE_URL=postgresql://patchflow:patchflow@localhost:5433/patchflow

# Redis 连接串（BullMQ 队列使用；Compose 默认宿主端口 6380，避免与本机 6379 冲突）
REDIS_URL=redis://localhost:6380

# -----------------------------------------------------------------------------
# 以下变量仅供 docker compose 覆盖本地依赖使用，不是应用运行时变量。
# 生产环境必须使用更强的密码，并限制端口只绑定内网或 CI 网络。
# -----------------------------------------------------------------------------
# POSTGRES_PORT=5433
# POSTGRES_USER=patchflow
# POSTGRES_PASSWORD=patchflow
# POSTGRES_DB=patchflow
# REDIS_PORT=6380
